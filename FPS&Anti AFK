local function applyFPSCap(value)
    if setfpscap then
        setfpscap(value)
    end
end

local function validateFPSInput()
    local newFPS = tonumber(FPSInput.Text)
    if newFPS and newFPS > 0 and newFPS <= 360 then
        customFPS = math.floor(newFPS)
    end
    FPSInput.Text = tostring(customFPS)
end

local function updateFPSUI()
    if isCustomFPS then
        applyFPSCap(customFPS)
        currentFPS = customFPS
        FPSToggleButton.Text = "FPS: " .. customFPS .. "\nClick: Normal"
        FPSToggleButton.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    else
        applyFPSCap(normalFPS)
        currentFPS = normalFPS
        FPSToggleButton.Text = "FPS: Normal\nClick: " .. customFPS .. " FPS"
        FPSToggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    end
end

local function toggleFPS()
    validateFPSInput()
    isCustomFPS = not isCustomFPS
    updateFPSUI()
end

local function toggleAntiAfk()
    antiAfkEnabled = not antiAfkEnabled
    
    if antiAfkEnabled then
        AfkToggleButton.Text = "Anti-AFK: ENABLED"
        AfkToggleButton.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        if not antiAfkBusy then
            AfkStatusLabel.Text = "Anti-AFK Status: Active"
            AfkStatusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
        end
    else
        AfkToggleButton.Text = "Anti-AFK: DISABLED"
        AfkToggleButton.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
        AfkStatusLabel.Text = "Anti-AFK Status: Disabled"
        AfkStatusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
    end
end

local function handleIdled()
    if not antiAfkEnabled then 
        return 
    end
    
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new(0, 0))
    
    antiAfkBusy = true
    AfkStatusLabel.Text = "Kicked blocked successfully!"
    AfkStatusLabel.TextColor3 = Color3.fromRGB(241, 196, 15)
    
    task.wait(3)
    
    antiAfkBusy = false
    if antiAfkEnabled then
        AfkStatusLabel.Text = "Anti-AFK Status: Active"
        AfkStatusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
    end
end

