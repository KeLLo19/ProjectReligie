local function makeDraggable(frame)
    local dragging = false
    local dragInput, dragStart, startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

makeDraggable(MainFrame)

local function applyFPSCap(value)
    if setfpscap then
        setfpscap(value)
    end
end

local function validateFPSInput()
    local newFPS = tonumber(FPSInput.Text)
    if newFPS and newFPS > 0 and newFPS <= 360 then
        customFPS = math.floor(newFPS)
    end
    FPSInput.Text = tostring(customFPS)
end

local function updateFPSUI()
    if isCustomFPS then
        applyFPSCap(customFPS)
        currentFPS = customFPS
        FPSToggleButton.Text = "FPS: " .. customFPS .. "\nClick: Normal"
        FPSToggleButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    else
        applyFPSCap(normalFPS)
        currentFPS = normalFPS
        FPSToggleButton.Text = "FPS: Normal\nClick: " .. customFPS .. " FPS"
        FPSToggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    end
end

local function toggleFPS()
    validateFPSInput()
    isCustomFPS = not isCustomFPS
    updateFPSUI()
end

local function toggleAntiAfk()
    antiAfkEnabled = not antiAfkEnabled
    
    if antiAfkEnabled then
        AfkToggleButton.Text = "Anti-AFK: ENABLED"
        AfkToggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        if not antiAfkBusy then
            AfkStatusLabel.Text = "Anti-AFK: ON"
            AfkStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
        end
    else
        AfkToggleButton.Text = "Anti-AFK: DISABLED"
        AfkToggleButton.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        AfkStatusLabel.Text = "Anti-AFK: OFF"
        AfkStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

local function handleIdled()
    if not antiAfkEnabled then 
        return 
    end
    
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new(0, 0))
    
    antiAfkBusy = true
    AfkStatusLabel.Text = "Roblox tried kicking you but I didn't let them!"
    AfkStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    
    task.wait(3)
    
    antiAfkBusy = false
    if antiAfkEnabled then
        AfkStatusLabel.Text = "Anti-AFK: ON"
        AfkStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    end
end

