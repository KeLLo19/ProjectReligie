pcall(function()
    local network = ReplicatedStorage:WaitForChild("Network", 5)
    if not network then return end
    local plotsInvoke = network:WaitForChild("Plots_Invoke", 5)
    if not plotsInvoke then return end
    
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        if self == plotsInvoke and (method == "InvokeServer" or method == "invokeServer") then
            if args[2] == "SD_Collect" and type(args[1]) == "number" then
                cachedPlotIdArg = args[1]
            end
        end
        return oldNamecall(self, ...)
    end)
end)

local function setPlayerFrozen(freeze)
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        root.Anchored = freeze
    end
end

local function tpToEgg(eggId)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local targetEgg = nil
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == eggId or obj:GetAttribute("EggId") == eggId or (obj:IsA("Model") and string.find(obj.Name, "Garden")) then
            targetEgg = obj
            break
        end
    end

    if targetEgg then
        local eggCFrame = targetEgg:IsA("Model") and targetEgg:GetPrimaryPartCFrame() or targetEgg.CFrame
        if eggCFrame then
            local frontPosition = eggCFrame * CFrame.new(0, 0, -4)
            character.HumanoidRootPart.CFrame = CFrame.lookAt(frontPosition.Position, eggCFrame.Position)
        end
    end
end

local function doHatchSequence(eggId)
    local network = ReplicatedStorage:FindFirstChild("Network")
    if not network then return end

    local clickRemote = network:FindFirstChild("Click")
    local hatchRemote = network:FindFirstChild("CustomEggs_Hatch")
    local reqHatchRemote = network:FindFirstChild("Index: Request Hatch Count")

    if clickRemote then
        local char = LocalPlayer.Character
        local headPos = (char and char:FindFirstChild("Head")) and char.Head.Position or Vector3.new(1295.3, 259.0, -2361.4)
        local targetPos = Vector3.new(1315.8, 240.0, -2352.3)
        local dir = (targetPos - headPos).Unit

        for i = 1, 3 do
            pcall(function()
                clickRemote:FireServer(Ray.new(headPos, dir), targetPos)
            end)
            task.wait(0.05)
        end
    end

    local userMaxHatch = nil
    if reqHatchRemote then
        pcall(function()
            userMaxHatch = reqHatchRemote:InvokeServer()
        end)
    end

    if type(userMaxHatch) ~= "number" or userMaxHatch <= 0 then
        userMaxHatch = 52
    end

    if hatchRemote then
        pcall(function()
            hatchRemote:InvokeServer(eggId, userMaxHatch)
        end)
    end

    task.wait(0.15)
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
    local centerX = viewport.X / 2
    local centerY = viewport.Y / 2

    for i = 1, 5 do
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
        end)
        task.wait(0.04)
    end
end

local function autoCollectFreeGifts()
    if not autoGiftsEnabled or not scriptRunning then return end
    
    local network = ReplicatedStorage:FindFirstChild("Network")
    if not network then return end
    
    local redeemRemote = network:FindFirstChild("Redeem Free Gift")
    if not redeemRemote then return end

    for slot = 1, 12 do
        if not scriptRunning or not autoGiftsEnabled then break end

        pcall(function()
            redeemRemote:InvokeServer(slot)
        end)

        task.wait(0.2)
    end
end

