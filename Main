    Eggs = Instance.new("ScrollingFrame"),
    Upgrades = Instance.new("ScrollingFrame"),
    Graphics = Instance.new("ScrollingFrame"),
    Settings = Instance.new("ScrollingFrame")
}

local TabButtons = {}
local tabIcons = { Dashboard = "📊 ", Automation = "⚡ ", Eggs = "🥚 ", Upgrades = "📈 ", Graphics = "🎨 ", Settings = "⚙️ " }
local sectionHeaderList = {}
local staticAccentButtonsList = {}
local colorPickerButtonsList = {}
local dashboardLiveBoxesList = {}

local presetButtonsMap = {}
local configButtonsMap = {}
local selectedPresetName = "Default Dark"
local selectedConfigName = "Default Config"

local rebuildPresetSelectionList
local rebuildConfigSelectionList

local function updateAllDynamicElementsColor()
    for name, btn in pairs(TabButtons) do
        if btn and btn.Parent then
            local tabFrame = Tabs[name]
            if tabFrame and tabFrame.Visible then
                btn.BackgroundColor3 = C_ACCENT
            end
        end
    end
    
    for name, itemBtn in pairs(presetButtonsMap) do
        if itemBtn and itemBtn.Parent then
            itemBtn.BackgroundColor3 = (name == selectedPresetName) and C_ACCENT or C_PRESET_SELECTION
        end
    end

    if configButtonsMap then
        for name, configBtn in pairs(configButtonsMap) do
            if configBtn and configBtn.Parent then
                configBtn.BackgroundColor3 = (name == selectedConfigName) and C_ACCENT or C_CONFIG_SELECTION
            end
        end
    end

    if not isCustomFPS and fpsBtn and fpsBtn.Parent then
        fpsBtn.BackgroundColor3 = C_BUTTON
    end

    for _, header in ipairs(sectionHeaderList) do
        if header and header.Parent then
            header.TextColor3 = C_SECTION_HEADER
        end
    end

    for _, btn in ipairs(staticAccentButtonsList) do
        if btn and btn.Parent then
            btn.BackgroundColor3 = C_BUTTON
        end
    end

    for _, btn in ipairs(colorPickerButtonsList) do
        if btn and btn.Parent then
            btn.BackgroundColor3 = C_BUTTON
        end
    end

    for _, box in ipairs(dashboardLiveBoxesList) do
        if box and box.Parent then
            box.BackgroundColor3 = C_DASHBOARD_LIVE
        end
    end

    for _, container in ipairs(containerFramesList) do
        if container and container.Parent then
            container.BackgroundColor3 = C_CONTAINERS
        end
    end
end

local function createTab(name, layoutOrder)
    local frame = Tabs[name]
    frame.Name = name .. "Tab"
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.ScrollBarThickness = 4
    frame.CanvasSize = UDim2.new(0, 0, 0, 0)
    frame.Visible = false
    frame.Parent = ContentContainer

    local layout = Instance.new("UIListLayout", frame)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        frame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 25)
    end)

    local btn = Instance.new("TextButton", NavContainer)
    btn.Name = name .. "Btn"
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = C_ACCENT
    btn.BackgroundTransparency = 1
    btn.Font = FONT_BOLD
    btn.RichText = true
    btn.Text = "<b>" .. (tabIcons[name] or "") .. name .. "</b>"
    btn.TextColor3 = C_SUBTEXT
    btn.TextSize = 11
    btn.LayoutOrder = layoutOrder
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    TabButtons[name] = btn

    btn.MouseButton1Click:Connect(function()
        for tabName, tabFrame in pairs(Tabs) do
            tabFrame.Visible = (tabName == name)
        end
        updateActiveTabStyles(name)
    end)
end

function updateActiveTabStyles(activeName)
    for tabName, tBtn in pairs(TabButtons) do
        if tabName == activeName then
            tBtn.BackgroundColor3 = C_ACCENT
            tBtn.BackgroundTransparency = 0
            tBtn.TextColor3 = C_TEXT
        else
            tBtn.BackgroundColor3 = C_CARD
            tBtn.BackgroundTransparency = 1
            tBtn.TextColor3 = C_SUBTEXT
        end
    end
end

createTab("Dashboard", 1)
createTab("Automation", 2)
createTab("Eggs", 3)
createTab("Upgrades", 4)
createTab("Graphics", 5)
createTab("Settings", 6)

Tabs.Dashboard.Visible = true
updateActiveTabStyles("Dashboard")

