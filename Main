local function loadPresetsFromFile()
    if readfile and isfile and isfile(SETTINGS_FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SETTINGS_FILE_NAME))
        end)
        if success and type(result) == "table" then
            for name, data in pairs(result) do
                if data.BG and data.SIDEBAR and data.CARD and data.PROFILE and data.ACCENT then
                    savedThemePresets[name] = {
                        BG = Color3.new(data.BG[1], data.BG[2], data.BG[3]),
                        SIDEBAR = Color3.new(data.SIDEBAR[1], data.SIDEBAR[2], data.SIDEBAR[3]),
                        CARD = Color3.new(data.CARD[1], data.CARD[2], data.CARD[3]),
                        PROFILE = Color3.new(data.PROFILE[1], data.PROFILE[2], data.PROFILE[3]),
                        ACCENT = Color3.new(data.ACCENT[1], data.ACCENT[2], data.ACCENT[3]),
                        BUTTON = data.BUTTON and Color3.new(data.BUTTON[1], data.BUTTON[2], data.BUTTON[3]) or Color3.new(data.ACCENT[1], data.ACCENT[2], data.ACCENT[3]),
                        SECTION_HEADER = data.SECTION_HEADER and Color3.new(data.SECTION_HEADER[1], data.SECTION_HEADER[2], data.SECTION_HEADER[3]) or Color3.new(data.ACCENT[1], data.ACCENT[2], data.ACCENT[3]),
                        STATBOX = data.STATBOX and Color3.new(data.STATBOX[1], data.STATBOX[2], data.STATBOX[3]) or Color3.fromRGB(18, 18, 25),
                        DASHBOARD_LIVE = data.DASHBOARD_LIVE and Color3.new(data.DASHBOARD_LIVE[1], data.DASHBOARD_LIVE[2], data.DASHBOARD_LIVE[3]) or (data.PROFILE and Color3.new(data.PROFILE[1], data.PROFILE[2], data.PROFILE[3]) or Color3.fromRGB(18, 18, 25)),
                        CONTAINERS = data.CONTAINERS and Color3.new(data.CONTAINERS[1], data.CONTAINERS[2], data.CONTAINERS[3]) or Color3.fromRGB(18, 18, 26),
                        PRESET_SELECTION = data.PRESET_SELECTION and Color3.new(data.PRESET_SELECTION[1], data.PRESET_SELECTION[2], data.PRESET_SELECTION[3]) or Color3.fromRGB(24, 24, 34),
                        CONFIG_SELECTION = data.CONFIG_SELECTION and Color3.new(data.CONFIG_SELECTION[1], data.CONFIG_SELECTION[2], data.CONFIG_SELECTION[3]) or Color3.fromRGB(24, 24, 34)
                    }
                end
            end
        end
    end
end

local function savePresetsToFile()
    if writefile then
        pcall(function()
            local serializable = {}
            for name, data in pairs(savedThemePresets) do
                serializable[name] = {
                    BG = {data.BG.R, data.BG.G, data.BG.B},
                    SIDEBAR = {data.SIDEBAR.R, data.SIDEBAR.G, data.SIDEBAR.B},
                    CARD = {data.CARD.R, data.CARD.G, data.CARD.B},
                    PROFILE = {data.PROFILE.R, data.PROFILE.G, data.PROFILE.B},
                    ACCENT = {data.ACCENT.R, data.ACCENT.G, data.ACCENT.B},
                    BUTTON = {data.BUTTON.R, data.BUTTON.G, data.BUTTON.B},
                    SECTION_HEADER = {data.SECTION_HEADER.R, data.SECTION_HEADER.G, data.SECTION_HEADER.B},
                    STATBOX = {data.STATBOX.R, data.STATBOX.G, data.STATBOX.B},
                    DASHBOARD_LIVE = {data.DASHBOARD_LIVE.R, data.DASHBOARD_LIVE.G, data.DASHBOARD_LIVE.B},
                    CONTAINERS = {data.CONTAINERS.R, data.CONTAINERS.G, data.CONTAINERS.B},
                    PRESET_SELECTION = {data.PRESET_SELECTION.R, data.PRESET_SELECTION.G, data.PRESET_SELECTION.B},
                    CONFIG_SELECTION = {data.CONFIG_SELECTION.R, data.CONFIG_SELECTION.G, data.CONFIG_SELECTION.B}
                }
            end
            writefile(SETTINGS_FILE_NAME, HttpService:JSONEncode(serializable))
        end)
    end
end

loadPresetsFromFile()

local FONT_FREDOKA = Enum.Font.FredokaOne
