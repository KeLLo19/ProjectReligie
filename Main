saveConfigBtn.TextColor3 = C_TEXT
saveConfigBtn.TextSize = 10
Instance.new("UICorner", saveConfigBtn).CornerRadius = UDim.new(0, 6)

local autoLoadToggleBtn = Instance.new("TextButton", configCard)
autoLoadToggleBtn.Size = UDim2.new(0.38, 0, 0, 28)
autoLoadToggleBtn.Position = UDim2.new(0.60, 0, 0, 112)
autoLoadToggleBtn.BackgroundColor3 = (autoLoadConfigName ~= "") and C_SUCCESS or Color3.fromRGB(60, 60, 75)
autoLoadToggleBtn.Font = FONT_BOLD
autoLoadToggleBtn.RichText = true
autoLoadToggleBtn.Text = (autoLoadConfigName ~= "") and "<b>AUTO-LOAD: ON</b>" or "<b>AUTO-LOAD: OFF</b>"
autoLoadToggleBtn.TextColor3 = C_TEXT
autoLoadToggleBtn.TextSize = 9
Instance.new("UICorner", autoLoadToggleBtn).CornerRadius = UDim.new(0, 6)

local deleteConfigBtn = Instance.new("TextButton", configCard)
deleteConfigBtn.Size = UDim2.new(0.38, 0, 0, 28)
deleteConfigBtn.Position = UDim2.new(0.60, 0, 0, 144)
deleteConfigBtn.BackgroundColor3 = C_DANGER
deleteConfigBtn.Font = FONT_BOLD
deleteConfigBtn.RichText = true
deleteConfigBtn.Text = "<b>DELETE CONFIG</b>"
deleteConfigBtn.TextColor3 = C_TEXT
deleteConfigBtn.TextSize = 10
Instance.new("UICorner", deleteConfigBtn).CornerRadius = UDim.new(0, 6)

rebuildConfigSelectionList = function()
    for _, child in ipairs(configSelectScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for name, _ in pairs(savedConfigs) do
        count = count + 1
        local itemBtn = Instance.new("TextButton", configSelectScroll)
        itemBtn.Size = UDim2.new(1, -4, 0, 24)
        itemBtn.BackgroundColor3 = (selectedConfigName == name) and C_ACCENT or C_CONFIG_SELECTION
        itemBtn.Font = FONT_MEDIUM
        itemBtn.RichText = true
        itemBtn.Text = "<b>" .. name .. "</b>"
        itemBtn.TextColor3 = C_TEXT
        itemBtn.TextSize = 10
        Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)

        configButtonsMap[name] = itemBtn

        itemBtn.MouseButton1Click:Connect(function()
            selectedConfigName = name
            for n, btn in pairs(configButtonsMap) do
                if btn and btn.Parent then
                    btn.BackgroundColor3 = (n == selectedConfigName) and C_ACCENT or C_CONFIG_SELECTION
                end
            end
        end)
    end
    configSelectScroll.CanvasSize = UDim2.new(0, 0, 0, (count * 28) + 4)
end

rebuildConfigSelectionList()

loadConfigBtn.MouseButton1Click:Connect(function()
    local configData = savedConfigs[selectedConfigName]
    if configData then
        applyConfigData(configData)
        sendNotification("Config Loaded", "Loaded configuration: " .. selectedConfigName, 3)
    end
end)

saveConfigBtn.MouseButton1Click:Connect(function()
    showInputDialog(
        "💾 Save Configuration",
        "Enter a name for your configuration:",
        "My Config",
        function(configName)
            if configName and configName ~= "" then
                savedConfigs[configName] = {
                    antiAfk = antiAfkEnabled,
                    autoMerchant = autoMerchantEnabled,
                    autoGifts = autoGiftsEnabled,
                    autoJoinEvent = autoJoinEventEnabled,
                    autoPetsCoinsEvent = autoPetsCoinsEventEnabled,
                    customFPS = customFPS,
                    isCustomFPS = isCustomFPS
                }
                saveConfigsToFile()
                selectedConfigName = configName
                rebuildConfigSelectionList()
                sendNotification("Config Saved", "Successfully saved config: " .. configName, 3)
            else
                sendNotification("Error", "Configuration name cannot be empty!", 3)
            end
        end,
        function() end
    )
end)

autoLoadToggleBtn.MouseButton1Click:Connect(function()
    if autoLoadConfigName ~= "" then
        autoLoadConfigName = ""
        autoLoadToggleBtn.Text = "<b>AUTO-LOAD: OFF</b>"
        autoLoadToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        if writefile and isfile and isfile(AUTO_LOAD_CONFIG_FILE) then
            pcall(function() writefile(AUTO_LOAD_CONFIG_FILE, "") end)
        end
        sendNotification("Auto-Load", "Disabled auto-load config.", 3)
    else
        if selectedConfigName ~= "" then
            autoLoadConfigName = selectedConfigName
            autoLoadToggleBtn.Text = "<b>AUTO-LOAD: ON</b>"
            autoLoadToggleBtn.BackgroundColor3 = C_SUCCESS
            if writefile then
                pcall(function() writefile(AUTO_LOAD_CONFIG_FILE, autoLoadConfigName) end)
            end
            sendNotification("Auto-Load", "Set auto-load config to: " .. autoLoadConfigName, 3)
        else
            sendNotification("Error", "No configuration selected!", 3)
        end
    end
end)

deleteConfigBtn.MouseButton1Click:Connect(function()
    if not selectedConfigName then
        sendNotification("Error", "No configuration selected!", 3)
        return
    end

    showConfirmDialogCustom(
        "🗑️ Delete Configuration",
        "Are you sure you want to delete the configuration '" .. selectedConfigName .. "'? This action cannot be undone.",
        function()
            if savedConfigs[selectedConfigName] then
                savedConfigs[selectedConfigName] = nil
                saveConfigsToFile()
                
                local nextConfig = next(savedConfigs)
                if nextConfig then
                    selectedConfigName = nextConfig
                else
                    selectedConfigName = ""
                end
                
                rebuildConfigSelectionList()
                sendNotification("Config Deleted", "Successfully deleted configuration.", 3)
            end
        end
    )
end)
