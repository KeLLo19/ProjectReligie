local network = ReplicatedStorage:WaitForChild("Network", 5)

local function getPlayerRank()
    local defaultRank = "Normal User"
    local defaultColor = C_SUBTEXT

    local success, response = pcall(function()
        return game:HttpGet(DEVS_JSON_URL .. "?nocache=" .. tostring(os.time()))
    end)

    if success and response then
        local decodeSuccess, devData = pcall(function()
            return HttpService:JSONDecode(response)
        end)

        if decodeSuccess and type(devData) == "table" then
            local userIdStr = tostring(LocalPlayer.UserId)
            if devData[userIdStr] then
                local userRole = devData[userIdStr]
                
                if type(userRole) == "table" then
                    local roleName = userRole.Role or "Developer"
                    local r = userRole.Color and userRole.Color[1] or 241
                    local g = userRole.Color and userRole.Color[2] or 196
                    local b = userRole.Color and userRole.Color[3] or 15
                    return roleName, Color3.fromRGB(r, g, b)
                else
                    return tostring(userRole), Color3.fromRGB(241, 196, 15)
                end
            end
        end
    end

    return defaultRank, defaultColor
end

local function triggerJoinEvent()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    local mainLeft = playerGui:FindFirstChild("MainLeft")
    local left = mainLeft and mainLeft:FindFirstChild("Left")
    local tools = left and left:FindFirstChild("Tools")
    local joinEventBtn = tools and tools:FindFirstChild("JoinEvent")

    if joinEventBtn and joinEventBtn.Visible then
        if firesignal then
            if joinEventBtn:IsA("TextButton") or joinEventBtn:IsA("ImageButton") then
                firesignal(joinEventBtn.MouseButton1Click)
                firesignal(joinEventBtn.MouseButton1Down)
                firesignal(joinEventBtn.Activated)
            end
        else
            local pos = joinEventBtn.AbsolutePosition
            local size = joinEventBtn.AbsoluteSize
            local centerX = pos.X + (size.X / 2)
            local centerY = pos.Y + (size.Y / 2) + 36

            VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        end
    end
end

local function autoCollectFreeGifts()
    if not autoGiftsEnabled or not scriptRunning or not network then return end
    
    local redeemRemote = network:FindFirstChild("Redeem Free Gift")
    if not redeemRemote then return end

    for slot = 1, 12 do
        if not scriptRunning or not autoGiftsEnabled then break end
        pcall(function()
            redeemRemote:InvokeServer(slot)
        end)
        task.wait(0.2)
    end
end

local function rejoinServer()
    if #Players:GetPlayers() <= 1 then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end

local function serverHop()
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    local serversUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(serversUrl))
    end)
    
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.id ~= currentJobId and server.playing < server.maxPlayers then
                TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                return
            end
        end
    end
    TeleportService:Teleport(placeId, game.JobId, LocalPlayer)
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KHubUI"
ScreenGui.ResetOnSpawn = false
