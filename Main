local SETTINGS_CONFIG_FILE = "KHub_UserConfigs.json"
local AUTO_LOAD_CONFIG_FILE = "KHub_AutoLoadConfig.txt"

local savedConfigs = {
    ["Default Config"] = {
        antiAfk = true,
        autoMerchant = false,
        autoGifts = false,
        autoJoinEvent = false,
        autoPetsCoinsEvent = false,
        customFPS = 1,
        isCustomFPS = false
    }
}

local autoLoadConfigName = ""

local function loadConfigsFromFile()
    if readfile and isfile and isfile(SETTINGS_CONFIG_FILE) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SETTINGS_CONFIG_FILE))
        end)
        if success and type(result) == "table" then
            for name, data in pairs(result) do
                savedConfigs[name] = data
            end
        end
    end
    
    if readfile and isfile and isfile(AUTO_LOAD_CONFIG_FILE) then
        local success, result = pcall(function()
            return readfile(AUTO_LOAD_CONFIG_FILE)
        end)
        if success and result then
            autoLoadConfigName = result:gsub("^%s*(.-)%s*$", "%1") 
        end
    end
end

local function saveConfigsToFile()
    if writefile then
        pcall(function()
            writefile(SETTINGS_CONFIG_FILE, HttpService:JSONEncode(savedConfigs))
        end)
    end
end

loadConfigsFromFile()

local function applyConfigData(configData)
    if not configData then return end
    
    if configData.antiAfk ~= nil then
        antiAfkEnabled = configData.antiAfk
    end
    if configData.autoMerchant ~= nil then
        autoMerchantEnabled = configData.autoMerchant
        merchantBtn.Text = autoMerchantEnabled and "<b>ENABLED</b>" or "<b>DISABLED</b>"
        merchantBtn.BackgroundColor3 = autoMerchantEnabled and C_SUCCESS or C_DANGER
    end
    if configData.autoGifts ~= nil then
        autoGiftsEnabled = configData.autoGifts
        giftsBtn.Text = autoGiftsEnabled and "<b>ENABLED</b>" or "<b>DISABLED</b>"
        giftsBtn.BackgroundColor3 = autoGiftsEnabled and C_SUCCESS or C_DANGER
        if autoGiftsEnabled then task.spawn(autoCollectFreeGifts) end
    end
    if configData.autoJoinEvent ~= nil then
        autoJoinEventEnabled = configData.autoJoinEvent
        eventBtn.Text = autoJoinEventEnabled and "<b>ENABLED</b>" or "<b>DISABLED</b>"
        eventBtn.BackgroundColor3 = autoJoinEventEnabled and C_SUCCESS or C_DANGER
    end
    if configData.autoPetsCoinsEvent ~= nil then
        autoPetsCoinsEventEnabled = configData.autoPetsCoinsEvent
        petsCoinsBtn.Text = autoPetsCoinsEventEnabled and "<b>ENABLED</b>" or "<b>DISABLED</b>"
        petsCoinsBtn.BackgroundColor3 = autoPetsCoinsEventEnabled and C_SUCCESS or C_DANGER
    end
    if configData.customFPS ~= nil then
        customFPS = configData.customFPS
        fpsInput.Text = tostring(customFPS)
    end
    if configData.isCustomFPS ~= nil then
        isCustomFPS = configData.isCustomFPS
        if isCustomFPS then
            applyFPSCap(customFPS)
            fpsBtn.Text = "<b>FPS: " .. customFPS .. "</b>"
            fpsBtn.BackgroundColor3 = C_DANGER
        else
            applyFPSCap(normalFPS)
            fpsBtn.Text = "<b>FPS: Normal</b>"
            fpsBtn.BackgroundColor3 = C_BUTTON
        end
    end
end

if autoLoadConfigName ~= "" and savedConfigs[autoLoadConfigName] then
    task.spawn(function()
        task.wait(0.5) 
        applyConfigData(savedConfigs[autoLoadConfigName])
        sendNotification("Auto-Load Config", "Loaded config on start: " .. autoLoadConfigName, 3)
    end)
end

createSectionHeader(Tabs.Settings, "Configurations Management")

local configCard = createCard(Tabs.Settings, "⚙️ SCRIPT CONFIGURATIONS", 235)

