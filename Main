autoHatchBtn.MouseButton1Click:Connect(function()
    if not autoHatchEnabled then
        if not currentEggId then
            autoHatchEnabled = false
            autoHatchBtn.Text = "DISABLED"
            autoHatchBtn.BackgroundColor3 = C_DANGER
            
            showWarning(
                "⚠️ MISSING EGG ID",
                "Manually hatch the Garden Egg 1 time first to capture its ID! After doing that, press ENABLE again.",
                true
            )
            return
        end
        
        autoHatchEnabled = true
        autoHatchBtn.Text = "ENABLED"
        autoHatchBtn.BackgroundColor3 = C_SUCCESS
        tpToEgg(currentEggId)
        task.wait(0.1)
        setPlayerFrozen(true)
    else
        autoHatchEnabled = false
        autoHatchBtn.Text = "DISABLED"
        autoHatchBtn.BackgroundColor3 = C_DANGER
        setPlayerFrozen(false)
    end
end)

