local function createModernColorPickerCard(parent, labelText, defaultColor, onColorChanged)
    local card = createCard(parent, labelText, 72)
    createDescriptionLabel(card, "Click to customize color for " .. labelText .. ".")
    
    local previewBtn = Instance.new("TextButton", card)
    previewBtn.Size = UDim2.new(0.35, 0, 0, 28)
    previewBtn.Position = UDim2.new(0.62, 0, 0, 30)
    previewBtn.BackgroundColor3 = C_BUTTON
    previewBtn.Font = FONT_BOLD
    previewBtn.RichText = true
    previewBtn.Text = "<b>PICK COLOR</b>"
    previewBtn.TextColor3 = C_TEXT
    previewBtn.TextSize = 11
    Instance.new("UICorner", previewBtn).CornerRadius = UDim.new(0, 6)

    table.insert(colorPickerButtonsList, previewBtn)

    previewBtn.MouseButton1Click:Connect(function()
        isColorPickerOpen = true
        
        local pickerFrame = Instance.new("Frame", ScreenGui)
        pickerFrame.Size = UDim2.new(0, 340, 0, 220)
        pickerFrame.Position = UDim2.new(0.5, -170, 0.5, -110)
        pickerFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
        pickerFrame.BorderSizePixel = 0
        pickerFrame.ZIndex = 300
        Instance.new("UICorner", pickerFrame).CornerRadius = UDim.new(0, 12)
        local pStroke = Instance.new("UIStroke", pickerFrame)
        pStroke.Color = Color3.fromRGB(45, 45, 65)
        pStroke.Thickness = 1

        local pickerCloseBtn = Instance.new("TextButton", pickerFrame)
        pickerCloseBtn.Size = UDim2.new(0, 20, 0, 20)
        pickerCloseBtn.Position = UDim2.new(1, -22, 0, 12)
        pickerCloseBtn.BackgroundTransparency = 1
        pickerCloseBtn.Font = FONT_BOLD
        pickerCloseBtn.RichText = true
        pickerCloseBtn.Text = "<b>X</b>"
        pickerCloseBtn.TextColor3 = Color3.fromRGB(160, 165, 180)
        pickerCloseBtn.TextSize = 13
        pickerCloseBtn.ZIndex = 305

        pickerCloseBtn.MouseEnter:Connect(function()
            pickerCloseBtn.TextColor3 = C_DANGER
        end)
        pickerCloseBtn.MouseLeave:Connect(function()
            pickerCloseBtn.TextColor3 = Color3.fromRGB(160, 165, 180)
        end)

        local tLbl = Instance.new("TextLabel", pickerFrame)
        tLbl.Size = UDim2.new(1, -40, 0, 22)
        tLbl.Position = UDim2.new(0, 16, 0, 12)
        tLbl.BackgroundTransparency = 1
        tLbl.Font = FONT_BOLD
        tLbl.RichText = true
        tLbl.Text = '<b><font color="#7289DA">COLOR PICKER</font></b>'
        tLbl.TextColor3 = C_TEXT
        tLbl.TextSize = 12
        tLbl.ZIndex = 301

        local subLbl = Instance.new("TextLabel", pickerFrame)
        subLbl.Size = UDim2.new(1, -40, 0, 14)
        subLbl.Position = UDim2.new(0, 16, 0, 28)
        subLbl.BackgroundTransparency = 1
        subLbl.Font = FONT_MEDIUM
        subLbl.RichText = true
        subLbl.Text = "<b>SELECTION: " .. string.upper(labelText) .. "</b>"
        subLbl.TextColor3 = Color3.fromRGB(120, 125, 145)
        subLbl.TextSize = 8
        subLbl.ZIndex = 301

        local colorBox = Instance.new("Frame", pickerFrame)
        colorBox.Size = UDim2.new(0, 65, 0, 65)
        colorBox.Position = UDim2.new(0, 16, 0, 52)
        colorBox.BackgroundColor3 = defaultColor
        colorBox.BorderSizePixel = 0
        colorBox.ZIndex = 301
        Instance.new("UICorner", colorBox).CornerRadius = UDim.new(0, 8)

        local currentH, currentS, currentV = defaultColor:ToHSV()
        local hexInput, updatePickerColor

        local sliderContainer = Instance.new("Frame", pickerFrame)
        sliderContainer.Size = UDim2.new(0, 225, 0, 65)
        sliderContainer.Position = UDim2.new(0, 96, 0, 52)
        sliderContainer.BackgroundTransparency = 1
        sliderContainer.ZIndex = 301

        local function createMiniSlider(posY, gradientColors, callback)
            local bar = Instance.new("Frame", sliderContainer)
            bar.Size = UDim2.new(1, 0, 0, 14)
            bar.Position = UDim2.new(0, 0, 0, posY)
            bar.BackgroundColor3 = Color3.new(1, 1, 1)
            bar.BorderSizePixel = 0
            bar.ZIndex = 302
            Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 4)

            local uig = Instance.new("UIGradient", bar)
            uig.Color = ColorSequence.new(gradientColors)

            local dragging = false
            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local absPos = bar.AbsolutePosition.X
                    local absSize = bar.AbsoluteSize.X
                    local mouseX = input.Position.X
                    local val = math.clamp((mouseX - absPos) / absSize, 0, 1)
                    callback(val)
                    updatePickerColor()
                end
            end)
        end

        updatePickerColor = function()
            local col = Color3.fromHSV(currentH, currentS, currentV)
            colorBox.BackgroundColor3 = col
            if hexInput then
                hexInput.Text = "#" .. string.format("%02X%02X%02X", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255))
            end
            onColorChanged(col)
            updateAllDynamicElementsColor()
        end

        createMiniSlider(0, {
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
        }, function(v) currentH = v end)

        createMiniSlider(24, {ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 100, 100)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))}, function(v) currentS = v end)
        createMiniSlider(48, {ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 200))}, function(v) currentV = v end)

        hexInput = Instance.new("TextBox", pickerFrame)
        hexInput.Size = UDim2.new(0, 100, 0, 32)
        hexInput.Position = UDim2.new(0, 16, 0, 136)
        hexInput.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
        hexInput.Font = FONT_BOLD
        hexInput.Text = "#" .. string.format("%02X%02X%02X", math.floor(defaultColor.R*255), math.floor(defaultColor.G*255), math.floor(defaultColor.B*255))
        hexInput.TextColor3 = C_TEXT
        hexInput.TextSize = 10
        hexInput.ZIndex = 301
        Instance.new("UICorner", hexInput).CornerRadius = UDim.new(0, 6)

        hexInput.FocusLost:Connect(function(enter)
            if enter then
                local cleanHex = hexInput.Text:gsub("#", "")
                if #cleanHex == 6 then
                    local r = tonumber(cleanHex:sub(1, 2), 16)
                    local g = tonumber(cleanHex:sub(3, 4), 16)
                    local b = tonumber(cleanHex:sub(5, 6), 16)
                    if r and g and b then
                        local newCol = Color3.fromRGB(r, g, b)
                        currentH, currentS, currentV = newCol:ToHSV()
                        updatePickerColor()
                    end
                end
            end
        end)

        local applyPickerBtn = Instance.new("TextButton", pickerFrame)
        applyPickerBtn.Size = UDim2.new(0, 192, 0, 32)
        applyPickerBtn.Position = UDim2.new(0, 128, 0, 136)
        applyPickerBtn.BackgroundColor3 = C_SUCCESS
        applyPickerBtn.Font = FONT_BOLD
        applyPickerBtn.RichText = true
        applyPickerBtn.Text = "<b>APPLY COLOR</b>"
        applyPickerBtn.TextColor3 = C_TEXT
        applyPickerBtn.TextSize = 10
        applyPickerBtn.ZIndex = 301
        Instance.new("UICorner", applyPickerBtn).CornerRadius = UDim.new(0, 6)

        local function closePicker()
            isColorPickerOpen = false
            pickerFrame:Destroy()
        end

        applyPickerBtn.MouseButton1Click:Connect(function()
            closePicker()
        end)

        pickerCloseBtn.MouseButton1Click:Connect(function()
            closePicker()
        end)
    end)

    return card
end

