local function sendNotification(title, message, duration)
    duration = duration or 3
    local toast = Instance.new("Frame", ScreenGui)
    toast.Name = "NotificationToast"
    toast.Size = UDim2.new(0, 240, 0, 65)
    toast.Position = UDim2.new(1, 260, 1, -80)
    toast.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    toast.BorderSizePixel = 0
    toast.ZIndex = 500
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke", toast)
    stroke.Color = C_ACCENT
    stroke.Thickness = 1

    local tLbl = Instance.new("TextLabel", toast)
    tLbl.Size = UDim2.new(1, -16, 0, 20)
    tLbl.Position = UDim2.new(0, 10, 0, 8)
    tLbl.BackgroundTransparency = 1
    tLbl.Font = FONT_BOLD
    tLbl.RichText = true
    tLbl.Text = "<b>" .. title .. "</b>"
    tLbl.TextColor3 = C_TEXT
    tLbl.TextSize = 11
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.ZIndex = 501

    local mbl = Instance.new("TextLabel", toast)
    mbl.Size = UDim2.new(1, -16, 0, 25)
    mbl.Position = UDim2.new(0, 10, 0, 28)
    mbl.BackgroundTransparency = 1
    mbl.Font = FONT_MEDIUM
    mbl.RichText = true
    mbl.Text = "<b>" .. message .. "</b>"
    mbl.TextColor3 = C_SUBTEXT
    mbl.TextSize = 10
    mbl.TextWrapped = true
    mbl.TextXAlignment = Enum.TextXAlignment.Left
    mbl.ZIndex = 501

    TweenService:Create(toast, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -250, 1, -80)
    }):Play()

    task.spawn(function()
        task.wait(duration)
        if toast and toast.Parent then
            TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(1, 260, 1, -80)
            }):Play()
            task.wait(0.3)
            toast:Destroy()
        end
    end)
end

