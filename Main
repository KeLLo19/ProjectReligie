local function teleportToSelectedOrNearestEgg()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local targetPos = nil
    local shortestDist = math.huge 
    local targetClean = selectedEggName and selectedEggName:lower():gsub("%s+", "") or ""

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Center" then
            local eggModel = obj.Parent
            
            if eggModel and (eggModel:FindFirstChild("Egg") or eggModel:FindFirstChild("EggLock") or eggModel:FindFirstChild("PriceFrame")) then
                local isMatch = false

                if autoNearestEggEnabled then
                    isMatch = true
                elseif autoSelectedEggEnabled and targetClean ~= "" then
                    if eggModel.Name:lower():gsub("%s+", ""):find(targetClean) then
                        isMatch = true
                    else
                        for _, desc in ipairs(eggModel:GetDescendants()) do
                            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                                local txt = desc.Text:lower():gsub("%s+", "")
                                if txt ~= "" and txt:find(targetClean) then
                                    isMatch = true
                                    break
                                end
                            elseif desc.Name:lower():gsub("%s+", ""):find(targetClean) then
                                isMatch = true
                                break
                            end
                        end
                    end
                end

                if isMatch then
                    local pos = obj.Position
                    local dist = (hrp.Position - pos).Magnitude

                    if dist < shortestDist then
                        shortestDist = dist
                        targetPos = pos
                    end
                end
            end
        end
    end

    if targetPos then
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    end
end

task.spawn(function()
    while scriptRunning do
        if autoNearestEggEnabled or autoSelectedEggEnabled then
            pcall(function()
                teleportToSelectedOrNearestEgg()
            end)
        end
        task.wait(0.2)
    end
end)

