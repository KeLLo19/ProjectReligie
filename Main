local modalAction = nil

local function showWarning(title, message, isAlertOnly, onConfirm)
    ModalTitle.Text = title
    ModalText.Text = message
    modalAction = onConfirm

    if isAlertOnly then
        ModalYes.Visible = false
        ModalNo.Size = UDim2.new(0.88, 0, 0, 32)
        ModalNo.Position = UDim2.new(0.06, 0, 0, 126)
        ModalNo.Text = "GOT IT"
    else
        ModalYes.Visible = true
        ModalYes.Size = UDim2.new(0.42, 0, 0, 32)
        ModalYes.Position = UDim2.new(0.06, 0, 0, 126)
        ModalNo.Size = UDim2.new(0.42, 0, 0, 32)
        ModalNo.Position = UDim2.new(0.52, 0, 0, 126)
        ModalNo.Text = "CANCEL"
    end

    ModalOverlay.Visible = true
end

ModalYes.MouseButton1Click:Connect(function()
    ModalOverlay.Visible = false
    if modalAction then modalAction() end
end)

ModalNo.MouseButton1Click:Connect(function()
    ModalOverlay.Visible = false
end)

local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
makeDraggable(MainFrame)

keybindBtn.MouseButton1Click:Connect(function()
    isListeningForKey = true
    keybindBtn.Text = "Press Any Key..."
    keybindBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
end)

local inputConnection
inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not scriptRunning then return end

    if isListeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentToggleKey = input.KeyCode
            keybindBtn.Text = "Key: " .. currentToggleKey.Name
            keybindBtn.BackgroundColor3 = C_ACCENT
            isListeningForKey = false
        end
        return
    end

    if not gameProcessed and input.KeyCode == currentToggleKey then
        uiVisible = not uiVisible
        MainFrame.Visible = uiVisible
    end
end)

local function applyFPSCap(val) if setfpscap then setfpscap(val) end end
local function validateFPSInput()
    local n = tonumber(fpsInput.Text)
    if n and n > 0 and n <= 360 then customFPS = math.floor(n) end
    fpsInput.Text = tostring(customFPS)
end

fpsBtn.MouseButton1Click:Connect(function()
    validateFPSInput()
    isCustomFPS = not isCustomFPS
    if isCustomFPS then
        applyFPSCap(customFPS)
        fpsBtn.Text = "FPS: " .. customFPS
        fpsBtn.BackgroundColor3 = C_DANGER
    else
        applyFPSCap(normalFPS)
        fpsBtn.Text = "FPS: Normal"
        fpsBtn.BackgroundColor3 = C_ACCENT
    end
end)

fpsInput.FocusLost:Connect(function(enter)
    if enter then validateFPSInput() end
end)

