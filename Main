rebuildPresetSelectionList = function()
    for _, child in ipairs(presetSelectScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for name, pData in pairs(savedThemePresets) do
        count = count + 1
        local itemBtn = Instance.new("TextButton", presetSelectScroll)
        itemBtn.Size = UDim2.new(1, -4, 0, 24)
        itemBtn.BackgroundColor3 = (selectedPresetName == name) and C_ACCENT or C_PRESET_SELECTION
        itemBtn.Font = FONT_MEDIUM
        itemBtn.RichText = true
        itemBtn.Text = "<b>" .. name .. "</b>"
        itemBtn.TextColor3 = C_TEXT
        itemBtn.TextSize = 10
        Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)

        presetButtonsMap[name] = itemBtn

        itemBtn.MouseButton1Click:Connect(function()
            selectedPresetName = name
            for n, btn in pairs(presetButtonsMap) do
                if btn and btn.Parent then
                    btn.BackgroundColor3 = (n == selectedPresetName) and C_ACCENT or C_PRESET_SELECTION
                end
            end
        end)
    end
    presetSelectScroll.CanvasSize = UDim2.new(0, 0, 0, (count * 28) + 4)
end

rebuildPresetSelectionList()

loadPresetBtn.MouseButton1Click:Connect(function()
    local pData = savedThemePresets[selectedPresetName]
    if pData then
        C_BG = pData.BG
        C_SIDEBAR = pData.SIDEBAR
        C_CARD = pData.CARD
        C_PROFILE = pData.PROFILE or Color3.fromRGB(18, 18, 25)
        C_ACCENT = pData.ACCENT or C_ACCENT
        C_BUTTON = pData.BUTTON or C_ACCENT
        C_SECTION_HEADER = pData.SECTION_HEADER or C_ACCENT
        C_STATBOX = pData.STATBOX or Color3.fromRGB(18, 18, 25)
        C_DASHBOARD_LIVE = pData.DASHBOARD_LIVE or Color3.fromRGB(18, 18, 25)
        C_CONTAINERS = pData.CONTAINERS or Color3.fromRGB(18, 18, 26)
        C_PRESET_SELECTION = pData.PRESET_SELECTION or Color3.fromRGB(24, 24, 34)
        C_CONFIG_SELECTION = pData.CONFIG_SELECTION or Color3.fromRGB(24, 24, 34)
        
        MainFrame.BackgroundColor3 = C_BG
        Sidebar.BackgroundColor3 = C_SIDEBAR
        ProfileCard.BackgroundColor3 = C_PROFILE
        
        for _, card in ipairs(cardsList) do
            if card and card.Parent then
                card.BackgroundColor3 = C_CARD
            end
        end
        
        updateAllDynamicElementsColor()
        rebuildPresetSelectionList()
        rebuildConfigSelectionList()
        
        sendNotification("Preset Loaded", "Loaded theme: " .. selectedPresetName, 3)
    end
end)

local function showInputDialog(titleText, descText, placeholderText, onConfirm, onCancel)
    local DialogOverlay = Instance.new("Frame", ScreenGui)
    DialogOverlay.Size = UDim2.new(1, 0, 1, 36)
    DialogOverlay.Position = UDim2.new(0, 0, 0, -36)
    DialogOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    DialogOverlay.BackgroundTransparency = 1
    DialogOverlay.ZIndex = 100

    local DialogBox = Instance.new("Frame", DialogOverlay)
    DialogBox.Size = UDim2.new(0, 0, 0, 0)
    DialogBox.Position = UDim2.new(0.5, 0, 0.5, 0)
    DialogBox.BackgroundColor3 = C_BG
    DialogBox.BorderSizePixel = 0
    DialogBox.ClipsDescendants = true
    DialogBox.ZIndex = 101
    Instance.new("UICorner", DialogBox).CornerRadius = UDim.new(0, 12)
    
    local DialogStroke = Instance.new("UIStroke", DialogBox)
    DialogStroke.Color = Color3.fromRGB(60, 60, 80)
    DialogStroke.Thickness = 1

    local DTitle = Instance.new("TextLabel", DialogBox)
    DTitle.Size = UDim2.new(1, -30, 0, 30)
    DTitle.Position = UDim2.new(0, 15, 0, 15)
    DTitle.BackgroundTransparency = 1
    DTitle.Font = FONT_BOLD
    DTitle.RichText = true
    DTitle.Text = "<b>" .. titleText .. "</b>"
    DTitle.TextColor3 = C_TEXT
    DTitle.TextSize = 14
    DTitle.TextXAlignment = Enum.TextXAlignment.Left
    DTitle.ZIndex = 102

    local DDesc = Instance.new("TextLabel", DialogBox)
    DDesc.Size = UDim2.new(1, -30, 0, 30)
    DDesc.Position = UDim2.new(0, 15, 0, 45)
    DDesc.BackgroundTransparency = 1
    DDesc.Font = FONT_MEDIUM
    DDesc.RichText = true
    DDesc.Text = "<b>" .. descText .. "</b>"
    DDesc.TextColor3 = C_SUBTEXT
    DDesc.TextSize = 11
    DDesc.TextXAlignment = Enum.TextXAlignment.Left
    DDesc.ZIndex = 102

    local InputBox = Instance.new("TextBox", DialogBox)
    InputBox.Size = UDim2.new(1, -30, 0, 34)
    InputBox.Position = UDim2.new(0, 15, 0, 78)
    InputBox.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    InputBox.Font = FONT_BOLD
    InputBox.PlaceholderText = placeholderText or "Enter name..."
    InputBox.Text = ""
    InputBox.TextColor3 = C_TEXT
    InputBox.TextSize = 11
    InputBox.ZIndex = 102
    Instance.new("UICorner", InputBox).CornerRadius = UDim.new(0, 8)

    local function closeDialog()
        TweenService:Create(DialogOverlay, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        TweenService:Create(DialogBox, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        task.wait(0.2)
        DialogOverlay:Destroy()
    end

    local ContinueBtn = Instance.new("TextButton", DialogBox)
    ContinueBtn.Size = UDim2.new(0.48, -5, 0, 34)
    ContinueBtn.Position = UDim2.new(0, 15, 1, -45)
    ContinueBtn.BackgroundColor3 = C_SUCCESS
    ContinueBtn.Font = FONT_BOLD
    ContinueBtn.RichText = true
    ContinueBtn.Text = "<b>CONTINUE</b>"
    ContinueBtn.TextColor3 = C_TEXT
    ContinueBtn.TextSize = 11
    ContinueBtn.ZIndex = 102
    Instance.new("UICorner", ContinueBtn).CornerRadius = UDim.new(0, 8)

    local CancelBtn = Instance.new("TextButton", DialogBox)
    CancelBtn.Size = UDim2.new(0.48, -5, 0, 34)
    CancelBtn.Position = UDim2.new(0.52, 0, 1, -45)
    CancelBtn.BackgroundColor3 = C_DANGER
    CancelBtn.Font = FONT_BOLD
    CancelBtn.RichText = true
    CancelBtn.Text = "<b>CANCEL</b>"
    CancelBtn.TextColor3 = C_TEXT
    CancelBtn.TextSize = 11
    CancelBtn.ZIndex = 102
    Instance.new("UICorner", CancelBtn).CornerRadius = UDim.new(0, 8)

    ContinueBtn.MouseButton1Click:Connect(function()
        local textVal = InputBox.Text
        closeDialog()
        if onConfirm then onConfirm(textVal) end
    end)

    CancelBtn.MouseButton1Click:Connect(function()
        closeDialog()
        if onCancel then onCancel() end
    end)

    TweenService:Create(DialogOverlay, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.4}):Play()
    TweenService:Create(DialogBox, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 350, 0, 185),
        Position = UDim2.new(0.5, -175, 0.5, -92.5)
    }):Play()
end

savePresetBtn.MouseButton1Click:Connect(function()
    showInputDialog(
        "💾 Save Custom Preset",
        "Enter a name for your custom color preset:",
        "My Custom Theme",
        function(presetName)
            if presetName and presetName ~= "" then
                savedThemePresets[presetName] = {
                    BG = C_BG,
                    SIDEBAR = C_SIDEBAR,
                    CARD = C_CARD,
                    PROFILE = C_PROFILE,
                    ACCENT = C_ACCENT,
                    BUTTON = C_BUTTON,
                    SECTION_HEADER = C_SECTION_HEADER,
                    STATBOX = C_STATBOX,
                    DASHBOARD_LIVE = C_DASHBOARD_LIVE,
                    CONTAINERS = C_CONTAINERS,
                    PRESET_SELECTION = C_PRESET_SELECTION,
                    CONFIG_SELECTION = C_CONFIG_SELECTION
                }
                savePresetsToFile()
                selectedPresetName = presetName
                rebuildPresetSelectionList()
                sendNotification("Preset Saved", "Successfully saved preset: " .. presetName, 3)
            else
                sendNotification("Error", "Preset name cannot be empty!", 3)
            end
        end,
        function() end
    )
end)

