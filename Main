local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if isColorPickerOpen then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not isColorPickerOpen and input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
makeDraggable(MainFrame)

local function showConfirmDialog(titleText, descText, onConfirm, onCancel)
    local DialogOverlay = Instance.new("Frame", ScreenGui)
    DialogOverlay.Size = UDim2.new(1, 0, 1, 36)
    DialogOverlay.Position = UDim2.new(0, 0, 0, -36)
    DialogOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    DialogOverlay.BackgroundTransparency = 1
    DialogOverlay.ZIndex = 100

    local DialogBox = Instance.new("Frame", DialogOverlay)
    DialogBox.Size = UDim2.new(0, 0, 0, 0)
    DialogBox.Position = UDim2.new(0.5, 0, 0.5, 0)
    DialogBox.BackgroundColor3 = C_BG
    DialogBox.BorderSizePixel = 0
    DialogBox.ClipsDescendants = true
    DialogBox.ZIndex = 101
    Instance.new("UICorner", DialogBox).CornerRadius = UDim.new(0, 12)
    
    local DialogStroke = Instance.new("UIStroke", DialogBox)
    DialogStroke.Color = Color3.fromRGB(60, 60, 80)
    DialogStroke.Thickness = 1

    local DTitle = Instance.new("TextLabel", DialogBox)
