end

local fpsVal = createStatBox(gridContainer, "FPS", 1)
local pingVal = createStatBox(gridContainer, "PING", 2)
local uptimeVal = createStatBox(gridContainer, "UPTIME", 3)
local memVal = createStatBox(gridContainer, "MEMORY", 4)

local startTime = os.time()

task.spawn(function()
    while scriptRunning do
        pcall(function()
            local currentFps = math.floor(1 / RunService.RenderStepped:Wait())
            local currentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            local currentMem = math.floor(Stats:GetTotalMemoryUsageMb())

            local elapsed = os.time() - startTime
            local hrs = math.floor(elapsed / 3600)
            local mins = math.floor((elapsed % 3600) / 60)
            local secs = elapsed % 60
            local uptimeFormatted = string.format("%02d:%02d:%02d", hrs, mins, secs)

            fpsVal.Text = "<b>" .. tostring(currentFps) .. "</b>"
            pingVal.Text = "<b>" .. currentPing .. " ms</b>"
            uptimeVal.Text = "<b>" .. uptimeFormatted .. "</b>"
            memVal.Text = "<b>" .. currentMem .. " MB</b>"
        end)
        task.wait(1)
    end
end)

