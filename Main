local function executePotatoMode()
    potatoModeEnabled = true
    potatoBtn.Text = "ON (Applied)"
    potatoBtn.BackgroundColor3 = C_SUCCESS
    
    pcall(function()
        UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 0
        
        for _, obj in ipairs(Lighting:GetChildren()) do obj:Destroy() end
        
        local function stripObject(v)
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.CastShadow = false
                v.Reflectance = 0
            elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Light") then
                v:Destroy()
            end
        end
        
        for _, v in ipairs(workspace:GetDescendants()) do stripObject(v) end
        workspace.DescendantAdded:Connect(function(v)
            if potatoModeEnabled then stripObject(v) end
        end)
        
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
        end
    end)
end

potatoBtn.MouseButton1Click:Connect(function()
    if not potatoModeEnabled then
        showWarning("⚠️ WARNING: POTATO MODE", "Are you sure? This lowers graphics and removes textures permanently for this session. Restart Roblox to revert!", false, executePotatoMode)
    end
end)

unloadBtn.MouseButton1Click:Connect(function()
    scriptRunning = false
    antiAfkEnabled = false
    autoMerchantEnabled = false
    autoCollectEnabled = false
    autoHatchEnabled = false
    autoGiftsEnabled = false
    setPlayerFrozen(false)
    
    RunService:Set3dRenderingEnabled(true)
    applyFPSCap(normalFPS)
    
    if inputConnection then
        inputConnection:Disconnect()
    end
    
    ScreenGui:Destroy()
end)

local function autoBuyMerchant()
    if not autoMerchantEnabled or not scriptRunning then return end
    local network = ReplicatedStorage:FindFirstChild("Network")
    if not network then return end
    
    local markApproached = network:FindFirstChild("Machines: Mark Approached")
    if markApproached then
        pcall(function() markApproached:FireServer("FarmingMerchantMachine") end)
        task.wait(0.2)
    end
    
    local requestPurchase = network:FindFirstChild("Merchant_RequestPurchase")
    if requestPurchase then
        for slot = 1, 6 do
            for attempt = 1, 7 do
                if not scriptRunning then break end
                pcall(function() requestPurchase:InvokeServer("FarmingMerchant", slot) end)
                task.wait(0.25)
            end
        end
    end
end

local function autoCollectPlots()
    if not autoCollectEnabled or not scriptRunning or not cachedPlotIdArg then return end
    local network = ReplicatedStorage:FindFirstChild("Network")
    if not network then return end
    
    local plotsInvoke = network:FindFirstChild("Plots_Invoke")
    if not plotsInvoke then return end

    for plotId = 1, 10 do
        if not scriptRunning or not autoCollectEnabled then break end
        
        pcall(function()
            plotsInvoke:InvokeServer(cachedPlotIdArg, "SD_Collect", tostring(plotId))
        end)

        task.wait(0.3)
    end
end

collectBtn.MouseButton1Click:Connect(function()
    if not autoCollectEnabled then
        if not cachedPlotIdArg then
            autoCollectEnabled = false
            collectBtn.Text = "DISABLED"
            collectBtn.BackgroundColor3 = C_DANGER
            
            showWarning(
                "⚠️ MISSING PLOT ID",
                "Manually collect 1 plot in-game first! After doing that, press ENABLE again.",
                true
            )
            return
        end
        
        autoCollectEnabled = true
        collectBtn.Text = "ENABLED"
        collectBtn.BackgroundColor3 = C_SUCCESS
        task.spawn(autoCollectPlots)
    else
        autoCollectEnabled = false
        collectBtn.Text = "DISABLED"
        collectBtn.BackgroundColor3 = C_DANGER
    end
end)

task.spawn(function()
    while scriptRunning do
        if autoHatchEnabled then
            doHatchSequence(currentEggId)
        end
        task.wait(0.5)
    end
end)

